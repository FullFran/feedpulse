{
  "name": "feedpulse",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Fran Blakia",
  "description": "RSS/Atom feed monitoring platform with keyword rule matching and multi-channel alerting, built on NestJS with hexagonal/DDD architecture and three runtimes (api, scheduler, worker).",
  "keywords": [
    "rss",
    "atom",
    "feed-monitoring",
    "alerting",
    "nestjs",
    "typescript",
    "postgresql",
    "bullmq",
    "hexagonal-architecture",
    "ddd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FullFran/feedpulse.git"
  },
  "bugs": {
    "url": "https://github.com/FullFran/feedpulse/issues"
  },
  "homepage": "https://github.com/FullFran/feedpulse#readme",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "ts-node --transpile-only src/main/api.ts",
    "start:scheduler": "ts-node --transpile-only src/main/scheduler.ts",
    "start:worker": "ts-node --transpile-only src/main/worker.ts",
    "start:api:prod": "node dist/main/api.js",
    "start:scheduler:prod": "node dist/main/scheduler.js",
    "start:worker:prod": "node dist/main/worker.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "apikey:create": "tsx src/scripts/create-api-key.ts",
    "demo:seed": "tsx scripts/demo/seed-demo.ts",
    "docs:openapi": "ts-node --transpile-only scripts/docs/dump-openapi.ts",
    "docs:screenshots": "tsx scripts/docs/capture-screenshots.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "test": "jest --runInBand",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:integration": "jest --runInBand --config jest.integration.config.ts",
    "test:cov": "jest --runInBand --coverage --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=lcov",
    "smoke:stack:up": "API_HOST_PORT=${SMOKE_API_HOST_PORT:-3300} POSTGRES_HOST_PORT=${SMOKE_POSTGRES_HOST_PORT:-56432} REDIS_HOST_PORT=${SMOKE_REDIS_HOST_PORT:-57379} SMOKE_MONITORING_PORT=${SMOKE_MONITORING_PORT:-4010} docker compose -p rss-monitor-smoke -f docker-compose.yml -f docker-compose.smoke.yml up -d --build",
    "smoke:stack:run": "API_HOST_PORT=${SMOKE_API_HOST_PORT:-3300} POSTGRES_HOST_PORT=${SMOKE_POSTGRES_HOST_PORT:-56432} REDIS_HOST_PORT=${SMOKE_REDIS_HOST_PORT:-57379} SMOKE_MONITORING_PORT=${SMOKE_MONITORING_PORT:-4010} SMOKE_API_BASE_URL=${SMOKE_API_BASE_URL:-http://127.0.0.1:${SMOKE_API_HOST_PORT:-3300}} SMOKE_FIXTURE_PUBLIC_URL=${SMOKE_FIXTURE_PUBLIC_URL:-http://127.0.0.1:${SMOKE_MONITORING_PORT:-4010}} tsx scripts/smoke/run-stack-smoke.ts",
    "smoke:stack:down": "docker compose -p rss-monitor-smoke -f docker-compose.yml -f docker-compose.smoke.yml down -v --remove-orphans",
    "smoke:ci": "sh -c 'npm run smoke:stack:up && npm run smoke:stack:run; status=$?; npm run smoke:stack:down; exit $status'",
    "benchmark:stack:up": "API_HOST_PORT=${BENCHMARK_API_HOST_PORT:-3400} POSTGRES_HOST_PORT=${BENCHMARK_POSTGRES_HOST_PORT:-57432} REDIS_HOST_PORT=${BENCHMARK_REDIS_HOST_PORT:-58379} SMOKE_MONITORING_PORT=${BENCHMARK_MONITORING_PORT:-4110} docker compose -p rss-monitor-benchmark -f docker-compose.yml -f docker-compose.smoke.yml up -d --build",
    "benchmark:run": "BENCHMARK_API_BASE_URL=${BENCHMARK_API_BASE_URL:-http://127.0.0.1:${BENCHMARK_API_HOST_PORT:-3400}} BENCHMARK_FIXTURE_PUBLIC_URL=${BENCHMARK_FIXTURE_PUBLIC_URL:-http://127.0.0.1:${BENCHMARK_MONITORING_PORT:-4110}} tsx scripts/benchmark/run-feed-capacity.ts",
    "benchmark:stack:down": "docker compose -p rss-monitor-benchmark -f docker-compose.yml -f docker-compose.smoke.yml down -v --remove-orphans",
    "benchmark:stage:100": "BENCHMARK_STAGES=100 npm run benchmark:run",
    "benchmark:stage:1000": "BENCHMARK_STAGES=1000 npm run benchmark:run",
    "benchmark:stage:5000": "BENCHMARK_STAGES=5000 npm run benchmark:run",
    "benchmark:stage:10000": "BENCHMARK_STAGES=10000 npm run benchmark:run",
    "benchmark:stages:mvp": "BENCHMARK_STAGES=100,1000,5000,10000 npm run benchmark:run",
    "benchmark:stage:100:safe": "sh -c 'npm run benchmark:stack:up && npm run benchmark:stage:100; status=$?; npm run benchmark:stack:down; exit $status'"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rss-parser": "^3.13.0",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "pg-mem": "^3.0.5",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.2.2"
    },
    "brace-expansion": "^5.0.8"
  }
}
