# EditorConfig — https://editorconfig.org
# Mirrors .prettierrc.json so editors and CI agree before Prettier ever runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sql,yml,yaml,json}]
indent_size = 2
