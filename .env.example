# =============================================================================
# FeedPulse configuration template. Copy to `.env` and edit before deploying.
# Every value below is parsed and validated at startup by
# src/shared/config/env.schema.ts; an unknown or malformed value fails the boot
# instead of silently degrading.
# =============================================================================

# --- Core runtime ---
# `production` is the safe posture: it activates the auth refinement below,
# switches logs to machine-readable NDJSON and turns Swagger UI off by default.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Force-exit deadline armed after the first SIGINT/SIGTERM, in milliseconds.
SHUTDOWN_TIMEOUT_MS=30000

# --- Database / Redis credentials (used by compose.dokploy.yml) ---
POSTGRES_DB=rss_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- Internal container-to-container URLs (Dokploy / Docker network) ---
DATABASE_URL=postgres://postgres:change_me@postgres:5432/rss_monitor
REDIS_URL=redis://redis:6379

# --- Auth ---
# API authentication is ON. Credentials live in the `api_keys` table; mint one with
#   npm run apikey:create -- --tenant my-tenant --label laptop
# The plaintext key is printed exactly once and cannot be recovered afterwards.
# Every /api/ call must send `x-api-key: <key>` or `Authorization: Bearer <key>`.
# Valid AUTH_PROVIDER values: api_key | clerk | clerk_api_key. Anything else fails
# startup instead of silently disabling authentication.
ENABLE_AUTH=true
AUTH_PROVIDER=clerk_api_key
# Seeded into api_keys by `npm run migrate` so the stack works out of the box.
# CHANGE IT before exposing the API. Format: fp_<8 chars>_<secret>
BOOTSTRAP_API_KEY=fp_bootstr_change-me-before-you-expose-this
BOOTSTRAP_API_KEY_TENANT_ID=legacy
# Local development only: resolves EVERY request to the shared `legacy` tenant
# with no credential at all. Rejected at startup when NODE_ENV=production.
#   NODE_ENV=development
#   ENABLE_AUTH=false
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_API_URL=https://api.clerk.com

# --- HTTP edge ---
# Comma-separated browser origin allow-list. Empty disables CORS entirely.
CORS_ORIGINS=
# Serve Swagger UI at /docs and the OpenAPI document at /docs-json.
# Defaults to true outside production; set it to true explicitly to publish the
# API reference from a production instance.
ENABLE_SWAGGER=false

# --- Notifications ---
WEBHOOK_NOTIFIER_URL=
WEBHOOK_NOTIFIER_TIMEOUT_MS=5000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Maximum alert emails a single tenant may send per day, counted in Redis on a UTC
# day boundary. 0 disables the quota. When a tenant exhausts it the email channel
# is marked `failed` with a `quota_exceeded` reason instead of being dropped
# silently, and the alert can be re-driven with POST /api/v1/alerts/:id/deliver
# once the day rolls over.
RESEND_DAILY_LIMIT=100
TELEGRAM_BOT_TOKEN=
# Master key for per-tenant secret encryption (currently Telegram bot tokens).
# Optional: leave it empty and tenants cannot store their own bot token, so the
# global TELEGRAM_BOT_TOKEN above is used for everyone.
# Generate with: openssl rand -base64 32
# It must decode to at least 32 bytes of base64 key material; a shorter value or
# a well-known placeholder fails startup rather than silently protecting nothing.
# ROTATION: stored tokens are versioned (migration 0021) and re-encrypted
# automatically on first read after a deploy. Rotating this key WITHOUT re-saving
# every tenant's token disables Telegram for the affected tenants and raises
# rss_tenant_secret_decrypt_failures_total - it no longer silently falls back to
# the global bot.
TENANT_SECRETS_MASTER_KEY=
TELEGRAM_API_URL=https://api.telegram.org

# --- Scheduler / worker tuning ---
SCHEDULER_TICK_MS=15000
SCHEDULER_BATCH_SIZE=100
# Age (seconds) after which a scheduler claim on a feed is treated as abandoned and
# released. Must stay above RATE_LIMIT_MAX_BACKOFF_MS + FETCH_TIMEOUT_MS: a lower
# value releases feeds that are still being fetched and causes duplicate requests.
SCHEDULER_STUCK_FEED_THRESHOLD_SECONDS=300
WORKER_CONCURRENCY=5
FETCH_TIMEOUT_MS=10000
# Outbound fetch pacing, applied per feed domain. These throttle the requests
# FeedPulse makes to origins; the inbound section below is a different concern.
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_MAX_BACKOFF_MS=60000
RATE_LIMIT_BASE_BACKOFF_MS=1000

# --- Inbound API rate limiting and per-tenant caps ---
# These cap the requests CLIENTS make to FeedPulse, per tenant (per source IP on
# the unauthenticated /api/ routes). Counters are stored in REDIS_URL, so the
# ceilings hold across API replicas instead of being multiplied by the replica
# count. Exceeding one returns 429 with the standard JSON error envelope
# (`code: rate_limit_exceeded`), a Retry-After header and X-RateLimit-Limit /
# X-RateLimit-Remaining / X-RateLimit-Reset.
RATE_LIMIT_TTL_SECONDS=60
# Budget for every /api/ route. 0 disables this bucket.
RATE_LIMIT_MAX_REQUESTS=300
# Separate, tighter budget for the endpoints that enqueue work or spend the
# operator's outbound credentials: POST /api/v1/feeds/:id/check-now,
# POST /api/v1/feeds/validate, POST /api/v1/opml/imports,
# POST /api/v1/opml/imports/:id/confirm and POST /api/v1/alerts/:id/send.
# 0 disables this bucket.
RATE_LIMIT_WRITE_MAX_REQUESTS=30
# Maximum feed rows one tenant may own. Registering past it returns 403
# `feed_limit_reached`. 0 disables the cap.
MAX_FEEDS_PER_TENANT=500

# --- Outbound fetch safety (SSRF containment) ---
# Allow feeds and webhooks that point at loopback, RFC1918 or link-local hosts.
# Keep this false in production. The docker smoke/benchmark stacks set it to true
# because their fixture feed is served from an internal Docker service name.
ALLOW_PRIVATE_FEED_HOSTS=false
# Hard cap on the feed response body read from an origin, in bytes. Default 5 MiB.
FEED_FETCH_MAX_BYTES=5242880

# --- Ingestion limits ---
OPML_UPLOAD_MAX_BYTES=10485760
OPML_INITIAL_JITTER_MAX_SECONDS=120

# --- Observability ---
# Port where the worker exposes its /metrics endpoint (aggregated by the API's /metrics)
WORKER_METRICS_PORT=3001
# Interface the worker metrics server binds to. 0.0.0.0 is required for
# cross-container scraping in docker-compose; use 127.0.0.1 whenever the worker is
# not isolated inside a private network.
WORKER_METRICS_BIND=0.0.0.0
# Optional bearer token required by GET /metrics on both the API and the worker.
# Leave empty to keep /metrics open - only safe on a private network.
METRICS_AUTH_TOKEN=

# --- Feature flags ---
# Rollout guards for the CLI/TUI agent interface adapters. Both default to true
# when unset; set to false to keep the surface dark during a staged rollout.
AGENT_INTERFACE_V1=true
TUI_ENABLED=true

# --- Local/dev overrides (optional) ---
# Uncomment only when running host-mode docker compose locally.
# POSTGRES_HOST_PORT=55432
# REDIS_HOST_PORT=56379
# API_HOST_PORT=3000
# DOCKER_DATABASE_URL=postgres://postgres:postgres@postgres:5432/rss_monitor
# DOCKER_REDIS_URL=redis://redis:6379
# SMOKE_API_HOST_PORT=3300
# SMOKE_POSTGRES_HOST_PORT=56432
# SMOKE_REDIS_HOST_PORT=57379
# SMOKE_MONITORING_PORT=4010
# WORKER_METRICS_HOST_PORT=3001

# --- Testing (optional) ---
# Throwaway PostgreSQL 13+ used by the *.integration-spec.ts suites that need a
# real database. Those suites SKIP when it is unset. The target schema is WIPED
# (DROP SCHEMA public CASCADE) on every run - never point it at real data.
# The role must also be allowed to CREATE DATABASE and DROP DATABASE:
# test/migrations.integration-spec.ts provisions a throwaway database per run so
# it can apply db/migrations from empty without touching the schema other suites
# share. The default `postgres` superuser satisfies this.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/feedpulse_test
